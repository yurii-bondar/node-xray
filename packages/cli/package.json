{
  "name": "@node-xray/cli",
  "version": "0.0.0",
  "private": true,
  "description": "xray: real-time profiler for Node.js processes",
  "license": "MIT",
  "type": "module",
  "bin": {
    "xray": "dist/src/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/bin.js', 0o755)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@node-xray/agent": "*",
    "@node-xray/core": "*",
    "@node-xray/dashboard": "*"
  },
  "exports": {
    "./package.json": "./package.json"
  }
}
